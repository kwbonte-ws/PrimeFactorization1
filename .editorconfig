root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,json,xml,runsettings}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Layout: Allman braces, four spaces, and one statement per line.
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = one_less_than_current
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false
csharp_space_after_comma = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_around_binary_operators = before_and_after
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_space_between_method_declaration_parameter_list_parentheses = false
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Explicit diagnostic severities also enforce these preferences during builds.
csharp_style_namespace_declarations = file_scoped
csharp_prefer_braces = true
dotnet_style_require_accessibility_modifiers = for_non_interface_members
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false
dotnet_style_predefined_type_for_locals_parameters_members = true
dotnet_style_predefined_type_for_member_access = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true
csharp_prefer_simple_using_statement = true
csharp_style_expression_bodied_methods = false
csharp_style_expression_bodied_constructors = false

dotnet_diagnostic.IDE0003.severity = warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0009.severity = warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.IDE0040.severity = warning
dotnet_diagnostic.IDE0049.severity = warning
dotnet_diagnostic.IDE0063.severity = warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_diagnostic.IDE1006.severity = warning

# Preserve public instance APIs and composition; analyze implementation members.
dotnet_code_quality.CA1822.api_surface = private, internal

# PascalCase types and properties; interfaces start with I.
dotnet_naming_rule.types_use_pascal_case.severity = warning
dotnet_naming_rule.types_use_pascal_case.symbols = types
dotnet_naming_rule.types_use_pascal_case.style = pascal_case
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate

dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = interface_name
dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_rule.properties_use_pascal_case.severity = warning
dotnet_naming_rule.properties_use_pascal_case.symbols = properties
dotnet_naming_rule.properties_use_pascal_case.style = pascal_case
dotnet_naming_symbols.properties.applicable_kinds = property, event

dotnet_naming_rule.parameters_and_locals_use_camel_case.severity = warning
dotnet_naming_rule.parameters_and_locals_use_camel_case.symbols = parameters_and_locals
dotnet_naming_rule.parameters_and_locals_use_camel_case.style = camel_case
dotnet_naming_symbols.parameters_and_locals.applicable_kinds = parameter, local

dotnet_naming_rule.private_fields_use_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_use_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_use_underscore_camel_case.style = private_field
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_rule.constants_use_pascal_case.severity = warning
dotnet_naming_rule.constants_use_pascal_case.symbols = constants
dotnet_naming_rule.constants_use_pascal_case.style = pascal_case
dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.interface_name.required_prefix = I
dotnet_naming_style.interface_name.capitalization = pascal_case
dotnet_naming_style.private_field.required_prefix = _
dotnet_naming_style.private_field.capitalization = camel_case

[src/**/*.cs]
# Test methods retain their existing Behavior_Scenario_Expectation names.
dotnet_naming_rule.methods_use_pascal_case.severity = warning
dotnet_naming_rule.methods_use_pascal_case.symbols = methods
dotnet_naming_rule.methods_use_pascal_case.style = pascal_case
dotnet_naming_symbols.methods.applicable_kinds = method

[tests/**/*.cs]
# Underscores separate behavior, scenario, and expectation in xUnit test names.
dotnet_diagnostic.CA1707.severity = none
