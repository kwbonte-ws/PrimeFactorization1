{
  "stryker-config": {
    "project": "PrimeFactorization.Domain.csproj",
    "test-runner": "vstest",
    "mutation-level": "Complete",
    "reporters": ["html", "json", "cleartext"],
    "break-on-initial-test-failure": true,
    "concurrency": 2,
    "mutate": [
      "**/*.cs",
      "!**/bin/**",
      "!**/obj/**",
      "!**/*.g.cs",
      "!**/*.g.i.cs",
      "!**/*.generated.cs"
    ]
  }
}
